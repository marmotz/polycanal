{
  "name": "@polycanal/codegen",
  "version": "0.0.0",
  "description": "Polycanal code generation: contract descriptions to TypeScript sources",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmotz/polycanal.git",
    "directory": "packages/codegen"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@polycanal/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@polycanal/core": "workspace:*"
  },
  "devDependencies": {
    "@polycanal/rest": "workspace:*",
    "@polycanal/zod": "workspace:*",
    "zod": "4.6.7"
  }
}
