{
  "name": "polycanal-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "build:docs": "bun run --filter '@polycanal/docs' build",
    "docs": "bun run --filter '@polycanal/docs' start",
    "docs:fr": "bun run --filter '@polycanal/docs' start:fr"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "tsup": "8.5.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
